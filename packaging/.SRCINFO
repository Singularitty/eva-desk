pkgbase = eva-desk-git
	pkgdesc = A Neon Genesis Evangelion desktop for Hyprland: bar, launcher, screenshots, wallpapers and Unit-01 behind your windows
	pkgver = r18.f690b62
	pkgrel = 1
	url = https://github.com/Singularitty/eva-desk
	install = eva-desk-git.install
	arch = any
	license = MIT
	makedepends = git
	depends = hyprland
	depends = python>=3.11
	depends = python-gobject
	depends = python-cairo
	depends = gtk4
	depends = gtk4-layer-shell
	optdepends = awww: workspace wallpapers (or swww)
	optdepends = grim: screenshots
	optdepends = wl-clipboard: screenshots to the clipboard
	optdepends = playerctl: now playing in the bar
	optdepends = wireplumber: volume in the bar
	optdepends = hyprlock: the lock screen
	optdepends = python-pillow: render the lock and login backgrounds
	optdepends = python-numpy: the GTK theme builder (eva-desk-setup --gtk) and the asset tools
	optdepends = python-scipy: the figure cutout tool (tools/gen)
	optdepends = kitty: the kitty theme (eva-extras)
	optdepends = starship: the prompt theme (eva-extras)
	optdepends = greetd-regreet: the login screen
	optdepends = libpulse: audio state and controls in the sound panel (pactl)
	optdepends = gojq: audio state in the sound panel (AUR)
	optdepends = geticons: app icons in the sound panel (AUR)
	optdepends = dunst: the do-not-disturb toggle in the sound panel (dunstctl)
	optdepends = wlsunset: the night light toggle in the sound panel
	optdepends = power-profiles-daemon: the power profile toggle in the sound panel (powerprofilesctl)
	provides = eva-desk
	conflicts = eva-desk
	source = eva-desk-git::git+https://github.com/Singularitty/eva-desk.git
	source = Doto.ttf::https://raw.githubusercontent.com/google/fonts/7085eb89a950e85db5b166b7a58d414544b4140c/ofl/doto/Doto%5BROND,wght%5D.ttf
	source = ShipporiMinchoB1-ExtraBold.ttf::https://raw.githubusercontent.com/google/fonts/7085eb89a950e85db5b166b7a58d414544b4140c/ofl/shipporiminchob1/ShipporiMinchoB1-ExtraBold.ttf
