	source = ShareTechMono-Regular.ttf::https://raw.githubusercontent.com/google/fonts/7085eb89a950e85db5b166b7a58d414544b4140c/ofl/sharetechmono/ShareTechMono-Regular.ttf
	source = Rubik.ttf::https://raw.githubusercontent.com/google/fonts/7085eb89a950e85db5b166b7a58d414544b4140c/ofl/rubik/Rubik%5Bwght%5D.ttf
